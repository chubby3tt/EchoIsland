{
  "build": {
    "distDir": "../web",
    "devPath": "http://localhost:1420",
    "beforeBuildCommand": ""
  },
  "package": {
    "productName": "Iris",
    "version": "0.1.0"
  },
  "tauri": {
    "bundle": {
      "active": true,
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "identifier": "com.chubby.echoisland",
      "targets": "all"
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "alwaysOnTop": true,
        "decorations": false,
        "fullscreen": false,
        "height": 50,
        "resizable": false,
        "skipTaskbar": true,
        "title": "Iris 2.0",
        "transparent": true,
        "width": 380
      }
    ]
  }
}
